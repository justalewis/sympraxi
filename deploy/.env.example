# Production settings for deploy/compose.yaml. Copy to deploy/.env.
# install.sh fills in the secrets for you. Never commit deploy/.env, and keep a
# copy of it away from the server: backups leave it out (docs/install.md).

# The address people will use, without https://
SYMPRAXI_DOMAIN=writing.example.edu
SYMPRAXI_ALLOWED_HOSTS=writing.example.edu
SYMPRAXI_CSRF_TRUSTED_ORIGINS=https://writing.example.edu
# Links in reminder emails start with https:// and the domain above. Set this
# only if people reach the site at a different address.
# SYMPRAXI_BASE_URL=https://writing.example.edu

# Secrets (install.sh generates these; use letters and digits only)
SYMPRAXI_SECRET_KEY=
POSTGRES_PASSWORD=
# Only while changing the secret key: the old one (docs/install.md, "Keys and passwords").
# SYMPRAXI_SECRET_KEY_FALLBACKS=

# Your institution
SYMPRAXI_SITE_NAME=Example College Writing Center
SYMPRAXI_TIME_ZONE=America/Los_Angeles
SYMPRAXI_FROM_EMAIL=writing-center@example.edu
# Campus SMTP relay. smtp+tls:// uses STARTTLS on port 587; smtp+ssl:// uses port 465.
EMAIL_URL=smtp+tls://username:password@smtp.example.edu:587
# Only addresses at these domains may create accounts (comma-separated). Leave empty to allow any.
SYMPRAXI_SIGNUP_EMAIL_DOMAINS=example.edu

# Web workers. Each answers one request at a time; start with twice the server's
# vCPUs plus one. See "Web workers" in docs/install.md.
WEB_CONCURRENCY=3

# Files people attach to appointments: the largest allowed, in MB. To scan each
# file for viruses before anyone can open it, start the optional ClamAV service
# (docker compose --profile clamav up -d) and set its address here. See "Files"
# in docs/install.md.
SYMPRAXI_UPLOAD_MAX_MB=25
SYMPRAXI_CLAMAV_ADDRESS=
# Turn this on only with the worker image that has LibreOffice in it, so Word and
# similar files can be commented on in the browser. See "Files" in docs/install.md.
SYMPRAXI_CONVERT_DOCUMENTS=false

# The weekly link checker visits each resource's website to see whether the page is
# still there, and tells directors which links broke or moved. It makes requests from
# this server to other sites (docs/install.md, "Link checker"). Off unless true.
SYMPRAXI_LINK_CHECK=false

# Video rooms on your own Jitsi server: see docs/jitsi.md. Fill in all three to let
# centers turn video on; leave them empty to keep video off. The secret is shared
# with Jitsi (its JWT_APP_SECRET); keep it only here and there.
SYMPRAXI_JITSI_DOMAIN=
SYMPRAXI_JITSI_APP_ID=
SYMPRAXI_JITSI_APP_SECRET=

# The shared document of a session: a long random secret shared by Sympraxi and the
# editor service (`openssl rand -hex 32`), then `docker compose --profile room up -d`.
# Leave it empty to keep the shared document off. See "Shared documents" in
# docs/install.md. SYMPRAXI_COLLAB_URL is only for an editor service reached at some
# other address than /collab/ on this site.
SYMPRAXI_COLLAB_SECRET=
SYMPRAXI_COLLAB_URL=

# Single sign-on: see "Single sign-on" in docs/install.md. Fill in all three lines
# for a provider to turn it on; leave them empty to keep it off. Client secrets
# live only in this file, never in the database.
# Microsoft Entra ID (the tenant ID is a GUID; "common" is refused):
SYMPRAXI_ENTRA_TENANT_ID=
SYMPRAXI_ENTRA_CLIENT_ID=
SYMPRAXI_ENTRA_CLIENT_SECRET=
# Google Workspace (the hosted domain is your Workspace domain, e.g. example.edu):
SYMPRAXI_GOOGLE_HOSTED_DOMAIN=
SYMPRAXI_GOOGLE_CLIENT_ID=
SYMPRAXI_GOOGLE_CLIENT_SECRET=
# Any other OpenID Connect provider (Okta, Keycloak, and so on): the issuer is the https
# address that serves /.well-known/openid-configuration. SYMPRAXI_SIGNUP_EMAIL_DOMAINS
# must be set. The sign-in button's label is optional.
SYMPRAXI_OIDC_ISSUER=
SYMPRAXI_OIDC_CLIENT_ID=
SYMPRAXI_OIDC_CLIENT_SECRET=
SYMPRAXI_OIDC_NAME=
# CAS (version 2 or 3). The attributes name what the CAS server sends for each person.
SYMPRAXI_CAS_SERVER_URL=
SYMPRAXI_CAS_VERSION=3
SYMPRAXI_CAS_EMAIL_ATTRIBUTE=mail
SYMPRAXI_CAS_NAME_ATTRIBUTE=displayName
SYMPRAXI_CAS_STUDENT_ID_ATTRIBUTE=
# SAML 2.0. Give your identity provider Sympraxi's metadata from
# https://<your site>/accounts/saml/metadata/ . The certificate is the provider's signing
# certificate as one line: the base64 between the BEGIN and END lines, with no breaks.
SYMPRAXI_SAML_IDP_ENTITY_ID=
SYMPRAXI_SAML_IDP_SSO_URL=
SYMPRAXI_SAML_IDP_CERT=
SYMPRAXI_SAML_EMAIL_ATTRIBUTE=mail
SYMPRAXI_SAML_NAME_ATTRIBUTE=displayName
SYMPRAXI_SAML_STUDENT_ID_ATTRIBUTE=
# The name of the OpenID Connect claim that carries the student ID, if there is one.
SYMPRAXI_SSO_STUDENT_ID_CLAIM=
# Let staff skip Sympraxi's own 2FA step when the provider's token proves MFA.
SYMPRAXI_TRUST_IDP_MFA=false
# Hide password sign-in and sign-up once SSO works. Site administrators keep a
# break-glass password sign-in at /accounts/login/local/.
SYMPRAXI_SSO_ONLY=false

# Text message reminders (docs/install.md, "Text message reminders"). "console" only
# writes each text to the log, for trying it out; "twilio" sends them. Leave empty for off.
SYMPRAXI_SMS_PROVIDER=
SYMPRAXI_TWILIO_ACCOUNT_SID=
SYMPRAXI_TWILIO_AUTH_TOKEN=
SYMPRAXI_TWILIO_FROM=

# Demo site: sample people, a role picker at /demo/, no mail or texts ever sent, and a
# nightly reset (deploy/reset-demo.sh). Only for a server with no real records.
# SYMPRAXI_DEMO=true

# If you change Sympraxi's code, link to your changed source here (AGPL section 13).
# SYMPRAXI_SOURCE_CODE_URL=https://github.com/sympraxi/sympraxi
