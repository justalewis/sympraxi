# Copy to .env for development, or set these in deploy/.env for production.
# Every setting is documented in sympraxi/settings.py.

# Required
SYMPRAXI_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://sympraxi:sympraxi@localhost:5432/sympraxi

# Development only. Never set DEBUG in production.
SYMPRAXI_DEBUG=true

# Production
# SYMPRAXI_ALLOWED_HOSTS=writing.example.edu
# SYMPRAXI_CSRF_TRUSTED_ORIGINS=https://writing.example.edu
# SYMPRAXI_TRUST_X_FORWARDED_FOR=true
# SYMPRAXI_TIME_ZONE=America/Los_Angeles
# SYMPRAXI_SITE_NAME=Example College Writing Center
# SYMPRAXI_FROM_EMAIL=writing-center@example.edu
# EMAIL_URL=smtp+tls://user:password@smtp.example.edu:587
# SYMPRAXI_SIGNUP_EMAIL_DOMAINS=example.edu
# If you change the code, link to your changed source (AGPL section 13):
# SYMPRAXI_SOURCE_CODE_URL=https://github.com/sympraxi/sympraxi

# Optional
# CACHE_URL=redis://valkey:6379/0
# SYMPRAXI_REQUIRE_STAFF_MFA=true
# SYMPRAXI_SESSION_SECONDS=28800
# SYMPRAXI_QUEUE_EMAIL=true
