# Settings for backup.sh. Copy to deploy/backup.env. Kept apart from .env so the
# app containers never see backup credentials.

# How many nightly backups to keep on this server.
BACKUP_KEEP=14
# Where to write them (relative to deploy/ or absolute).
BACKUP_DIR=../backups

# Optional encrypted off-site copies with restic (https://restic.net).
# Keep restic's retention in line with your center's records-retention policy:
# a purged record still exists in every backup until that backup expires.
# RESTIC_REPOSITORY=s3:https://s3.example.edu/sympraxi-backups
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
